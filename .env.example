# OAE local development configuration
APP_ENV=development
APP_NAME=OAE
DATABASE_URL=sqlite:///./data/oae.db
SECRET_KEY=replace-with-a-random-secret
API_KEY_PEPPER=replace-with-a-random-pepper
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
MAX_JOB_SECONDS=300
GITHUB_TOKEN=optional-for-github-integrations
NEXT_PUBLIC_API_URL=http://localhost:8000
OAE_API_URL=http://localhost:8000
VERCEL=optional
SENTRY_DSN=optional
