# OAE local development configuration
APP_ENV=development
APP_NAME=OAE
DATABASE_URL=sqlite:///./data/oae.db
# Set deployment secrets through your environment manager; leave example values blank.
API_KEY_PEPPER=
SECRET_KEY=
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
MAX_JOB_SECONDS=300
# Optional GitHub API token for higher public-analysis rate limits.
GITHUB_TOKEN=
# Client and deployment integration boundaries.
NEXT_PUBLIC_API_URL=http://localhost:8000
OAE_API_URL=http://localhost:8000
VERCEL=
# Optional error tracking. No events are sent unless this is configured.
SENTRY_DSN=
# Local root for development workspace snapshots; production should use durable storage.
WORKSPACE_ROOT=./data/oae-workspaces
WORKSPACE_RETENTION_DAYS=30
WORKSPACE_QUOTA_BYTES=1073741824
WORKSPACE_QUOTA_COUNT=20
WORKSPACE_FILE_MAX_BYTES=104857600
# Set true only after PostgreSQL migrations and one or more oae-worker processes are running.
DURABLE_JOBS_ENABLED=false
DURABLE_JOB_LEASE_SECONDS=60
DURABLE_JOB_MAX_ATTEMPTS=3
DURABLE_JOB_RETRY_MAX_SECONDS=300
# Enable after migration 0003 is applied and an oae-relay process is healthy.
REALTIME_EVENTS_ENABLED=false
OUTBOX_RELAY_LEASE_SECONDS=30
OUTBOX_RELAY_BATCH_SIZE=50
OUTBOX_RELAY_RETRY_MAX_SECONDS=300
SSE_POLL_SECONDS=1.0
SSE_HEARTBEAT_SECONDS=15
SSE_MAX_CONNECTION_SECONDS=300
SSE_REPLAY_LIMIT=200
