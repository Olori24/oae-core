# Required public edge configuration. DNS for API_DOMAIN must point at this host before Caddy can obtain HTTPS certificates.
API_DOMAIN=api.example.com
CADDY_EMAIL=operations@example.com

# PostgreSQL bootstrap variables. Generate a unique password in the deployment secret manager.
POSTGRES_DB=oae
POSTGRES_USER=oae
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://oae:${POSTGRES_PASSWORD}@db:5432/oae

# Required application secrets. Do not commit populated values.
APP_ENV=production
API_KEY_PEPPER=
SECRET_KEY=

# Restrict browser and host access to deployed values.
ALLOWED_HOSTS=["api.example.com"]
CORS_ORIGINS=["https://oaeengineer-3nncbrhe.manus.space"]

# Shared durable workspace storage for API and workers.
WORKSPACE_ROOT=/app/data/oae-workspaces
WORKSPACE_RETENTION_DAYS=30
WORKSPACE_QUOTA_BYTES=1073741824
WORKSPACE_QUOTA_COUNT=20
WORKSPACE_FILE_MAX_BYTES=104857600

# Enable only after `docker compose ... run --rm migrate` has completed successfully.
DURABLE_JOBS_ENABLED=true
DURABLE_JOB_LEASE_SECONDS=60
DURABLE_JOB_MAX_ATTEMPTS=3
DURABLE_JOB_RETRY_MAX_SECONDS=300
REALTIME_EVENTS_ENABLED=true
OUTBOX_RELAY_LEASE_SECONDS=30
OUTBOX_RELAY_BATCH_SIZE=50
OUTBOX_RELAY_RETRY_MAX_SECONDS=300
SSE_POLL_SECONDS=1.0
SSE_HEARTBEAT_SECONDS=15
SSE_MAX_CONNECTION_SECONDS=300
SSE_REPLAY_LIMIT=200
