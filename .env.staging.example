# Copy to .env.production only on an isolated staging host.
# API_DOMAIN must resolve publicly to that host and TCP 80/443 must reach it.
API_DOMAIN=staging-api.example.com
CADDY_EMAIL=operator@example.com

POSTGRES_DB=oae
POSTGRES_USER=oae
POSTGRES_PASSWORD=replace-with-a-strong-staging-password
DATABASE_URL=postgresql://oae:${POSTGRES_PASSWORD}@db:5432/oae
API_KEY_PEPPER=replace-with-a-distinct-staging-secret

# Keep durability features off until the staging database has been migrated and
# the worker and relay have been started.
DURABLE_JOBS_ENABLED=false
REALTIME_EVENTS_ENABLED=false
WORKSPACE_ROOT=/app/data/oae-workspaces
SSE_MAX_CONNECTION_SECONDS=300
