# Copy to .env.production only on an isolated staging host.
# API_DOMAIN must resolve publicly to that host and TCP 80/443 must reach it.
APP_ENV=staging
API_DOMAIN=staging-api.example.com
CADDY_EMAIL=operator@example.com

POSTGRES_DB=oae
POSTGRES_USER=oae
POSTGRES_PASSWORD=replace-with-a-strong-staging-password
DATABASE_URL=postgresql://oae:${POSTGRES_PASSWORD}@db:5432/oae
API_KEY_PEPPER=replace-with-a-distinct-staging-secret
ALLOWED_HOSTS=["staging-api.example.com"]
CORS_ORIGINS=["https://oaeengineer-3nncbrhe.manus.space"]

# Keep durability features off until the staging database has been migrated and
# the worker and relay have been started.
DURABLE_JOBS_ENABLED=false
REALTIME_EVENTS_ENABLED=false
# Keep enforcement off until separate-principal approval and revocation evidence exists.
WORKER_AUTHORIZATION_ENFORCEMENT_ENABLED=false
API_CONTROL_RATE_LIMIT_PER_MINUTE=60
WORKSPACE_ROOT=/app/data/oae-workspaces
SSE_MAX_CONNECTION_SECONDS=300

# Open-weight inference is disabled until a separately secured model host has
# passed the governed model-host validation. Never expose that host publicly.
OPEN_WEIGHT_MODEL_ENABLED=false
OPEN_WEIGHT_MODEL_ENDPOINT=http://ollama:11434
OPEN_WEIGHT_MODEL_ALLOWED_MODELS=[]
OPEN_WEIGHT_MODEL_TIMEOUT_SECONDS=30
OPEN_WEIGHT_MODEL_MAX_PROMPT_CHARS=12000
OPEN_WEIGHT_MODEL_MAX_OUTPUT_TOKENS=1024
OPEN_WEIGHT_MODEL_MAX_RESPONSE_CHARS=16000
